class Country {
  final String name;
  final String flag;
  final String region;

  Country({required this.name, required this.flag, required this.region});

  factory Country.fromJson(Map<String, dynamic> json) {
    return Country(
      name: json['name']['common'] ?? 'Unknown',
      flag: json['flags']['png'] ?? '',
      region: json['region'] ?? 'Unknown',
    );
  }
}
